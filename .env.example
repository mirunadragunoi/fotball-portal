# Vite loads .env.<mode> per build (e.g. .env.football1 when running --mode football1)

VITE_API_BASE_URL=https://store.rvdhub.com
VITE_PORTAL_NAME=FootballPortal1

# store.product.type
VITE_PRODUCT_TYPE_HTML=1
VITE_PRODUCT_TYPE_ANDROID=2
VITE_PRODUCT_TYPE_VIDEO=5

# Trivia (Open Trivia DB) — dev uses Vite proxy /opentdb; prod uses URL below
# VITE_OPENTDB_URL=https://opentdb.com/api.php
# VITE_TRIVIA_AMOUNT=10
# VITE_TRIVIA_VIA_BACKEND=true

# History — requires backend GET /football/history/* endpoints

# reCAPTCHA v2 site key — get yours at console.google.com/recaptcha
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key_here
